          { "name": "HH",        "mode": "AboveBelow", "setpointA": 95, "setpointAMode": "Above", "priority": "Critical", "label": "Tank HH Interlock >= 95%" }
        ],
        "_modbusAddr": "HR 40001  (Unit 1, Address 0, Scale ÷100)"
      },
      {
