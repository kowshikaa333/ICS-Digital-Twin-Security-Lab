[
  {
    "id": "tank-flow-tab",
    "type": "tab",
    "label": "ICS Water Tank SCADA",
    "disabled": false
  },
  {
    "id": "mqtt-broker-local",
    "type": "mqtt-broker",
    "name": "Tank Gateway (localhost)",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-tank",
    "autoConnect": true,
    "usetls": false,
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "sub-telemetry",
    "type": "mqtt in",
    "z": "tank-flow-tab",
    "name": "Subscribe tank/telemetry",
    "topic": "tank/telemetry",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker-local",
    "x": 120,
    "y": 80,
    "wires": [["parse-telemetry"]]
  },
  {
    "id": "parse-telemetry",
    "type": "function",
    "z": "tank-flow-tab",
    "name": "Extract fields",
    "func": "msg.level       = msg.payload.level;\nmsg.setpoint    = msg.payload.setpoint;\nmsg.pressure    = msg.payload.pressure;\nmsg.temperature = msg.payload.temperature;\nmsg.pump        = msg.payload.fillPump;\nmsg.valve       = msg.payload.drainValve;\nmsg.alarmLow    = msg.payload.alarmLow;\nmsg.alarmHigh   = msg.payload.alarmHigh;\nmsg.mode        = msg.payload.mode;\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 80,
    "wires": [["debug-telemetry", "to-dashboard-gauge", "to-es-push", "alarm-check"]]
  },
  {
    "id": "debug-telemetry",
    "type": "debug",
    "z": "tank-flow-tab",
    "name": "Tank Telemetry",
    "active": true,
    "tosidebar": true,
    "x": 560,
    "y": 40,
    "wires": []
  },
  {
    "id": "to-dashboard-gauge",
    "type": "ui_gauge",
    "z": "tank-flow-tab",
    "name": "Tank Level",
    "group": "tank-ui-group",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Tank Level (%)",
    "label": "%",
    "format": "{{msg.level | number:1}}",
    "min": 0,
    "max": 100,
    "colors": ["#dc2626","#f59e0b","#22c55e"],
    "seg1": "10",
    "seg2": "90",
    "x": 560,
    "y": 80,
    "wires": []
  },
  {
    "id": "alarm-check",
    "type": "function",
    "z": "tank-flow-tab",
    "name": "Alarm filter",
    "func": "if (msg.alarmLow || msg.alarmHigh) {\n  msg.payload = msg.alarmHigh ? 'HIGH LEVEL ALARM' : 'LOW LEVEL ALARM';\n  return msg;\n}\nreturn null;",
    "outputs": 1,
    "x": 560,
    "y": 120,
    "wires": [["alarm-notify"]]
  },
  {
    "id": "alarm-notify",
    "type": "debug",
    "z": "tank-flow-tab",
    "name": "ALARM",
    "active": true,
    "tosidebar": true,
    "console": true,
    "x": 740,
    "y": 120,
    "wires": []
  },
  {
    "id": "to-es-push",
    "type": "http request",
    "z": "tank-flow-tab",
    "name": "Push to Elasticsearch",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://localhost:9200/tank-readings/_doc",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "x": 560,
    "y": 160,
    "wires": [[]]
  },
  {
    "id": "inject-auto-on",
    "type": "inject",
    "z": "tank-flow-tab",
    "name": "Set AUTO mode ON",
    "props": [{"p": "payload"}],
    "repeat": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "tank/commands/auto_mode",
    "payload": "true",
    "payloadType": "str",
    "x": 140,
    "y": 240,
    "wires": [["pub-command"]]
  },
  {
    "id": "inject-auto-off",
    "type": "inject",
    "z": "tank-flow-tab",
    "name": "Set MANUAL mode",
    "props": [{"p": "payload"}],
    "topic": "tank/commands/auto_mode",
    "payload": "false",
    "payloadType": "str",
    "x": 140,
    "y": 280,
    "wires": [["pub-command"]]
  },
  {
    "id": "inject-pump-on",
    "type": "inject",
    "z": "tank-flow-tab",
    "name": "Pump ON (manual)",
    "props": [{"p": "payload"}],
    "topic": "tank/commands/pump_manual",
    "payload": "true",
    "payloadType": "str",
    "x": 140,
    "y": 320,
    "wires": [["pub-command"]]
  },
  {
    "id": "inject-drain-on",
    "type": "inject",
    "z": "tank-flow-tab",
    "name": "Drain ON (manual)",
    "props": [{"p": "payload"}],
    "topic": "tank/commands/drain_manual",
    "payload": "true",
    "payloadType": "str",
    "x": 140,
    "y": 360,
    "wires": [["pub-command"]]
  },
  {
    "id": "inject-reset",
    "type": "inject",
    "z": "tank-flow-tab",
    "name": "Reset Level to 53%",
    "props": [{"p": "payload"}],
    "topic": "tank/commands/reset",
    "payload": "true",
    "payloadType": "str",
    "x": 140,
    "y": 400,
    "wires": [["pub-command"]]
  },
  {
    "id": "pub-command",
    "type": "mqtt out",
    "z": "tank-flow-tab",
    "name": "Publish command",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "broker": "mqtt-broker-local",
    "x": 380,
    "y": 320,
    "wires": []
  },
  {
    "id": "modbus-read",
    "type": "function",
    "z": "tank-flow-tab",
    "name": "Read via REST fallback",
    "func": "return { url: 'http://localhost:8080/tank/status', method: 'GET' };",
    "outputs": 1,
    "x": 160,
    "y": 480,
    "wires": [["http-get-status"]]
  },
  {
    "id": "http-get-status",
    "type": "http request",
    "z": "tank-flow-tab",
    "name": "GET /tank/status",
    "method": "GET",
    "ret": "obj",
    "url": "http://localhost:8080/tank/status",
    "x": 400,
    "y": 480,
    "wires": [["debug-telemetry"]]
  },
  {
    "id": "tank-ui-group",
    "type": "ui_group",
    "name": "Tank SCADA",
    "tab": "tank-ui-tab",
    "order": 1,
    "disp": true,
    "width": "12"
  },
  {
    "id": "tank-ui-tab",
    "type": "ui_tab",
    "name": "Water Tank",
    "icon": "dashboard",
    "order": 1
  }
]
